"use strict";
var ul = document.querySelector("ul");
ul.addEventListener("click", function(e) {
    e.preventDefault();
    var c1 = e.target.classList.contains("gallery__thumb");
    var c2 = e.target.classList.contains("list-item__link");
    if (!c1 && !c2) return;
    var bigImage = document.querySelector("#largeImg");
    if (e.target.tagName === "IMG") bigImage.src = e.target.parentElement.href;
    else bigImage.src = e.target.href;
});

